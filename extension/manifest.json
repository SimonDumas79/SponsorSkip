{
  "manifest_version": 3,
  "name": "SponsorSkip",
  "version": "0.7.0",
  "description": "Skips sponsor reads on YouTube. Claude reads each video's whole transcript to find them, through the SponsorSkip program on your PC.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SponsorSkip",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:4790/*",
    "https://www.youtube.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sponsorskip@simondumas.dev",
      "strict_min_version": "128.0"
    }
  }
}
